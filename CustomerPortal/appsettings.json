{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=./App_Data/customer-portal.db"
  },
  "Persistence": {
    "AutoMigrate": false
  },
  "Authentication": {
    "Cookie": {
      "Name": "CustomerPortal.Auth",
      "IdleTimeoutMinutes": 30,
      "AbsoluteTimeoutHours": 8
    }
  }
}
